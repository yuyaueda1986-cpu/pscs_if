<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio 2013 / MSBuild 12.0 / .NET Framework 4.5 用の従来形式プロジェクト。
  SDK 形式ではないため VS2013 でそのまま開ける。
  winscard.dll は x86 / x64 のどちらにも存在するので AnyCPU で問題ない。
-->
<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6C3F1E2A-5B47-4D9C-9E31-0A7B2D5F8C10}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>PcscIf</RootNamespace>
    <AssemblyName>PcscIf</AssemblyName>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!-- 日本語のコメント / 文字列を含むため、ソースは UTF-8 (BOM 付き) -->
    <CodePage>65001</CodePage>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <!--
      1 ファイル 1 型。ファイル名の LayerN_ が層番号で、数字が小さいほど呼び出し側、
      大きいほどハードウェア側。層構成の説明は Layer1_Pcsc.cs の先頭コメントを参照。
    -->
    <Compile Include="Common_Hex.cs" />
    <Compile Include="Layer1_DuplicateGuard.cs" />
    <Compile Include="Layer1_Pcsc.cs" />
    <Compile Include="Layer1_PcscOptions.cs" />
    <Compile Include="Layer1_PcscResult.cs" />
    <Compile Include="Layer1_PcscStatus.cs" />
    <Compile Include="Layer1_ScanObservation.cs" />
    <Compile Include="Layer2_Felica.cs" />
    <Compile Include="Layer2_FelicaLiteS.cs" />
    <Compile Include="Layer2_FelicaResponseKind.cs" />
    <Compile Include="Layer3_PcscResponse.cs" />
    <Compile Include="Layer3_TransceiveResult.cs" />
    <Compile Include="Layer4_IPcscTransport.cs" />
    <Compile Include="Layer4_Rcs300Transport.cs" />
    <Compile Include="Layer4_RfProtocol.cs" />
    <Compile Include="Layer5_Interop.cs" />
    <Compile Include="Layer5_PcscException.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
