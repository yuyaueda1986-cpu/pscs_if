<Project Sdk="Microsoft.NET.Sdk">

  <!--
    テスト用処理は .NET 10。ライブラリ本体 (../../src/PcscIf.cs) をリンク参照する。
    本体は .NET Framework 4.5 / C# 5.0 の範囲で書かれているため、そのまま .NET 10 でも通る。
    src/Properties/AssemblyInfo.cs は SDK が同等の属性を自動生成するため含めない。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PcscIfTest</RootNamespace>
    <AssemblyName>PcscIfTest</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\PcscIf.cs" Link="PcscIf.cs" />
  </ItemGroup>

</Project>
